<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Doppel, as it is given out: ONE DLL for the game's Mods folder, with the bot's brain
    (../BotBrain) built into it. Shared settings and the shared code: ../Directory.Build.props
  -->
  <PropertyGroup>
    <AssemblyName>Doppel</AssemblyName>
    <RootNamespace>Doppel</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BotBrain\*.cs" LinkBase="Brain" />
  </ItemGroup>
  <ItemGroup>
    <!-- The navmeshes of the levels, to find its way about. -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppUniTask">
      <HintPath>$(ManagedDir)\Il2CppUniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The Portals mod (if it is there): its portals, as ways for the bots to take. -->
    <Reference Include="Portals" Condition="Exists('$(GameDir)\Mods\Portals.dll')">
      <HintPath>$(GameDir)\Mods\Portals.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
